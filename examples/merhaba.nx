# Nexuslang v0.2 — Türkçe sözdizimi
fonksiyon selamla(ad):
    yaz("Merhaba, " + ad + "! Nexuslang'e hoş geldin.")

selamla("Toprak")

değişken miktar = 5
eğer miktar > 3:
    yaz("miktar 3'ten büyük")
değilse:
    yaz("miktar küçük")

tekrar 3 kez:
    yaz("Nexuslang: kendi dilinde kodla, Python'a köprü kur.")
